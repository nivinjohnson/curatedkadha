# Secure order email relay configuration
# Copy this to a local .env file or set these in your shell before starting secure_email_api.py

ORDER_SMTP_HOST=smtp.gmail.com
ORDER_SMTP_PORT=465
ORDER_SMTP_USER=your-smtp-user@example.com
ORDER_SMTP_PASS=your-app-password
ORDER_FROM_EMAIL=your-smtp-user@example.com
ORDER_TO_EMAIL=curatedkadha@gmail.com

# Frontend origin allowed to call the API
ORDER_ALLOW_ORIGIN=http://localhost:8000

# API bind port
ORDER_API_PORT=8787
